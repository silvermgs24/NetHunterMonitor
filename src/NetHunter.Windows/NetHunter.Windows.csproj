<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows collectors: IP Helper tables, ETW (Kernel-Network, DNS-Client), DNS cache, process info, Authenticode, DPAPI. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>NetHunter.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetHunter.Core\NetHunter.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NetHunter.Windows.Tests" />
  </ItemGroup>
</Project>
