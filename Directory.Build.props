<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Company>NetHunter Monitor</Company>
    <Product>NetHunter Monitor</Product>
    <Copyright>MIT License</Copyright>
    <!-- Native SQLite advisory noise is pinned by explicit references below; keep build output readable. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
